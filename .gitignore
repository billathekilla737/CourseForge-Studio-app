# ---------------------------------------------------------------------------
# CourseForge Studio .gitignore
#   1. NEVER commit credentials or anything derived from student data.
#      Everything the tool downloads or produces lives under data/ by design.
#   2. NEVER commit build output.
# ---------------------------------------------------------------------------

# --- credentials -----------------------------------------------------------
*.token
*.token.enc
canvas.token
canvas.token.txt
token-*.bin
canvas.config.*.json
canvas.state*.json
canvas.project*.json
config.json
config.local.json
secrets.json
.env

# --- everything downloaded or produced --------------------------------------
data/
work/
runs/

# --- student / course data and audit trails ---------------------------------
*grades*.json
*grades*.csv
*roster*.json
**/map.json
**/proposed-grades*.json
**/submissions/
attachments/
cache/
canvas-admin-audit.log
activity-log.jsonl
canvas-export/
grading/
private/
courses/
audit/
pdf-lab/
remediation-work/
pptx-work/
docx-work/
office-text-work/
pdf-triage/
batch-remediation/
**/*.work/

# --- pdf pipeline artefacts (anything the engine writes into a workdir) ------
**/pdf-fastlane/
**/original.pdf
**/fixed.pdf
**/fixed.pdf.part
**/fixed.pdf.prealt
**/*.part
**/figures/
**/figures-small/
**/result.json
**/summary.json
**/queue.json
**/validation.json
**/alt-todo.json
**/alt-summary.json
**/alt.json
startup-error.txt

# --- build output ------------------------------------------------------------
legacy/installer/dist*/
legacy/installer/build*/
legacy/installer/Output/
legacy/installer/python-embed/
legacy/installer/cache/
legacy/installer/_tools-keep/
*.exe
*.msi
build/
dist/

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editor / OS -------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
*.rtf

# Written by the in-app updater; records which revision this folder is running.
installed.json
